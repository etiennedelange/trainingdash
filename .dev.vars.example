# and treat it as a secret, not a nonce.
STRAVA_VERIFY_TOKEN=
# openssl rand -hex 32 — signing throws if this is empty.
SESSION_SECRET=
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com
ANTHROPIC_API_KEY=
